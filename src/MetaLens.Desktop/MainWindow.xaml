<Window x:Class="MetaLens.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MetaLens"
        Icon="pack://application:,,,/Assets/MetaLens.ico"
        Width="1120"
        Height="820"
        MinWidth="900"
        MinHeight="680"
        Background="#F3F5F8"
        AllowDrop="True"
        Drop="OnFileDrop"
        DragOver="OnDragOver">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#182230"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#667085"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#5B55E7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#151A2D">
            <Grid Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MetaLens" FontSize="23" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="File information, made clear." FontSize="12" Foreground="#B8C0D9" Margin="1,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Open file"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnOpenFileClick"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,26" MaxWidth="1050" HorizontalAlignment="Center">
                <Border Background="White" CornerRadius="10" Padding="22" BorderBrush="#E4E7EC" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Selected file" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="FileNameText" Text="Open a file to inspect its information" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="FilePathText" Text="You can also drag and drop a file here." Foreground="#667085" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="22" Margin="0,16,0,0" BorderBrush="#E4E7EC" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="File information" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Values supplied by Windows and the file system. Availability can vary by file system and permissions."
                                   Foreground="#667085" FontSize="12" Margin="0,0,0,15"/>
                        <DataGrid x:Name="InformationGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="False"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True"
                                  RowHeaderWidth="0"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0"
                                  MinHeight="190">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Information" Binding="{Binding Name}" Width="190"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="22" Margin="0,16,0,0" BorderBrush="#E4E7EC" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Embedded metadata" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="FormatText" Text="Format detection is performed when a file is opened." FontWeight="SemiBold" Margin="0,3,0,5"/>
                        <TextBlock x:Name="EmbeddedMetadataText"
                                   Text="MetaLens currently shows file-system information only. Embedded format metadata is not yet edited."
                                   Foreground="#667085" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="22" Margin="0,16,0,10" BorderBrush="#E4E7EC" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Edit file-system metadata" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Times use your local time zone (yyyy-MM-dd HH:mm:ss.fffffff). Changes are previewed before they are written."
                                   Foreground="#667085" FontSize="12" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Created" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="CreationTimeInput" IsEnabled="False"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Last accessed" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="LastAccessTimeInput" IsEnabled="False"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Last modified" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="LastWriteTimeInput" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                        <DockPanel Margin="0,18,0,0">
                            <CheckBox x:Name="ReadOnlyInput"
                                      Content="Read-only attribute"
                                      IsEnabled="False"
                                      VerticalAlignment="Center"
                                      Foreground="#344054"/>
                            <Button x:Name="SaveButton"
                                    Content="Review and save"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="OnSaveClick"
                                    IsEnabled="False"
                                    DockPanel.Dock="Right"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#E9EDF3">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="#475467" FontSize="12" VerticalAlignment="Center" Margin="30,0"/>
        </Border>
    </Grid>
</Window>
